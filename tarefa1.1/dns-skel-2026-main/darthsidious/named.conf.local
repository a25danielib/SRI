key "transfer-key" {
    algorithm hmac-sha256;
    secret "c3VwZXJzZWNyZXRrZXkxMjM0NTY3ODkwMTIzNDU=";
};

server 192.168.20.10 {
    keys { "transfer-key"; };
};

zone "starwars.lan" {
    type slave;
    file "/var/cache/bind/db.starwars.lan";
    masters { 192.168.20.10 key "transfer-key"; };
};

zone "20.168.192.in-addr.arpa" {
    type slave;
    file "/var/cache/bind/db.192.168.20";
    masters { 192.168.20.10 key "transfer-key"; };
};